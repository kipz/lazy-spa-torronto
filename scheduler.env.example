# Copy to scheduler.env and adjust. This file is gitignored -- it contains
# YOUR spa's location and preferences, not repo facts.

# Location: city name/postcode (geocoded via Open-Meteo) OR explicit coords
LOCATION=London, UK
# LAT=51.5074
# LON=-0.1278

# Daily use window(s), 24h "HH:MM-HH:MM" (single per day for now).
# If the end is earlier than the start the window crosses midnight, e.g.
# 22:00-01:00 starts on the configured day and ends the following morning.
# Per-day overrides: WINDOW_MON, WINDOW_TUE, ... WINDOW_SUN
WINDOW=17:00-23:00
# WINDOW_SAT=14:00-01:00

# Temperatures (degrees C, spa's display unit)
TARGET_TEMP=40      # setpoint during use windows (device clamp is 40)
ECO_TEMP=28         # comfort floor while unused (raises preheat from colder)
FLOOR_TEMP=8        # hard floor -- never let the water drop below this
MARGIN=0.0          # extra degC held above TARGET (compartment-sensor safety)

# Thermal model (kW/degC etc). Defaults are fine; 'calibrate' overrides.
# C_KWH_PER_C=1.45
# P_HEAT_KW=2.0
# UA_KW_PER_C=0.03

# Optional refinements
# WIND_SENSITIVITY=0.0    # UA scales with wind (per m/s). 0 = ignore wind
# SOLAR_GAIN_KW=0.0       # peak kW absorbed from sun on the cover

# Planning
# HORIZON_H=48
# LOG_FILE=scheduler.log
