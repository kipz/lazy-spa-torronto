# Telegram notifications — copy to telegram.env and fill in.
# Get a token from @BotFather (new bot, e.g. "torronto-spa").
# Chat id: create a private channel, add the bot as an admin, then message it
# and grab the chat id from @getidsbot (or /getUpdates). A channel id is
# negative, e.g. -1001234567890; a direct chat with the bot is your user id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=